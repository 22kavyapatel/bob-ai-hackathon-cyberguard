# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai — leave blank to run in offline/demo mode with rule-based summaries
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Backend server
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Application mode
APP_ENV=development
